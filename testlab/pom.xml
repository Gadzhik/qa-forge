<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test Lab — охота на баги.
  Для каждого бага есть "жалоба пользователя". Ваша задача — написать автотест,
  который ПРОХОДИТ на исправном приложении и ПАДАЕТ, когда баг включён.

  Ваши тесты:   src/test/java/ru/qacourse/testlab/student/BugXXXTest.java
  Проверки:     src/test/java/ru/qacourse/testlab/checks/BugXXXCheck.java (не меняйте)

  Проверить один сценарий:  ./mvnw -pl testlab test -Dtest=Bug101Check
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.qacourse</groupId>
        <artifactId>exercises-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../exercises/pom.xml</relativePath>
    </parent>
    <artifactId>testlab</artifactId>
    <name>Test Lab — охота на баги</name>

    <dependencies>
        <dependency><groupId>ru.qacourse</groupId><artifactId>test-support</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.codeborne</groupId><artifactId>selenide</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Через Maven запускаются только проверки; ваши тесты они запускают сами -->
                    <includes>
                        <include>**/*Check.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <selenide.headless>true</selenide.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
