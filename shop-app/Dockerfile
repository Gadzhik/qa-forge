# Образ учебного приложения. Перед сборкой образа соберите jar:
#   ./mvnw -pl shop-app -am package -DskipTests
# Каждая строка разобрана в уроке 15.1 «Docker».

# Базовый образ: только среда выполнения Java 21 (JRE), без компилятора — так образ меньше
FROM eclipse-temurin:21-jre

# Рабочая папка внутри контейнера
WORKDIR /app

# Копируем собранный исполняемый jar в образ
COPY target/shop-app-1.0.0-exec.jar app.jar

# Документируем, что приложение слушает порт 8081
EXPOSE 8081

# Команда, которая выполняется при старте контейнера
ENTRYPOINT ["java", "-jar", "app.jar"]
