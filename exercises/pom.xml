<?xml version="1.0" encoding="UTF-8"?>
<!--
  Родитель всех практических заданий.
  Здесь в одном месте зафиксированы версии библиотек для тестирования,
  чтобы в каждом задании не повторять их заново.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.qacourse</groupId>
    <artifactId>exercises-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Задания курса</name>

    <modules>
        <module>test-support</module>
        <module>m00-hello</module>
        <module>m03-java-basics</module>
        <module>m04-java-oop</module>
        <module>m05-java-advanced</module>
        <module>m06-build-tools</module>
        <module>m07-junit</module>
        <module>m08-http</module>
        <module>m09-rest-assured</module>
        <module>m10-ui</module>
        <module>m11-databases</module>
        <module>m12-mocks</module>
        <module>m13-kafka-async</module>
        <module>m14-framework</module>
        <module>m15-docker-ci</module>
        <module>m16-incidents</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.13.4</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <rest-assured.version>5.5.7</rest-assured.version>
        <selenide.version>7.19.0</selenide.version>
        <allure.version>2.35.5</allure.version>
        <wiremock.version>3.13.2</wiremock.version>
        <testng.version>7.12.0</testng.version>
        <datafaker.version>2.7.0</datafaker.version>
        <owner.version>1.0.12</owner.version>
        <lombok.version>1.18.48</lombok.version>
        <awaitility.version>4.3.0</awaitility.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <kafka.version>3.9.2</kafka.version>
        <postgresql.version>42.7.14</postgresql.version>
        <hikari.version>6.3.3</hikari.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <poi.version>5.5.1</poi.version>
        <aspectj.version>1.9.25</aspectj.version>
        <slf4j.version>2.0.18</slf4j.version>
        <!-- та же версия, что в Spring Boot 3.5.16 (иначе учебное приложение не запустится из тестов) -->
        <jackson.version>2.21.4</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.junit</groupId><artifactId>junit-bom</artifactId><version>${junit.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>io.qameta.allure</groupId><artifactId>allure-bom</artifactId><version>${allure.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId><version>${jackson.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-bom</artifactId><version>${testcontainers.version}</version><type>pom</type><scope>import</scope></dependency>

            <dependency><groupId>ru.qacourse</groupId><artifactId>test-support</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>ru.qacourse</groupId><artifactId>shop-app</artifactId><version>1.0.0</version></dependency>
            <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>${assertj.version}</version></dependency>
            <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><version>${rest-assured.version}</version></dependency>
            <dependency><groupId>io.rest-assured</groupId><artifactId>json-schema-validator</artifactId><version>${rest-assured.version}</version></dependency>
            <dependency><groupId>com.codeborne</groupId><artifactId>selenide</artifactId><version>${selenide.version}</version></dependency>
            <dependency><groupId>org.wiremock</groupId><artifactId>wiremock-standalone</artifactId><version>${wiremock.version}</version></dependency>
            <dependency><groupId>org.testng</groupId><artifactId>testng</artifactId><version>${testng.version}</version></dependency>
            <dependency><groupId>net.datafaker</groupId><artifactId>datafaker</artifactId><version>${datafaker.version}</version></dependency>
            <dependency><groupId>org.aeonbits.owner</groupId><artifactId>owner</artifactId><version>${owner.version}</version></dependency>
            <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version></dependency>
            <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><version>${awaitility.version}</version></dependency>
            <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>${kafka.version}</version></dependency>
            <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql.version}</version></dependency>
            <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId><version>${hikari.version}</version></dependency>
            <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>${pdfbox.version}</version></dependency>
            <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><version>${poi.version}</version></dependency>
            <!-- одна версия SLF4J для всех (иначе Kafka притащит старую 1.7 и сломает логирование Spring Boot) -->
            <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version></dependency>
            <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>${slf4j.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- В отчётах показывать названия тестов из @DisplayName, а не имена методов -->
                        <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                        </statelessTestsetReporter>
                        <!-- Не падать, если в модуле нет теста, указанного через -Dtest -->
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
