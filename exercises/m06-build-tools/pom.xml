<?xml version="1.0" encoding="UTF-8"?>
<!--
  Модуль 6: сборка и библиотеки. Этот pom.xml разобран построчно в уроке 6.2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Родитель: отсюда берутся версии библиотек и настройки плагинов -->
    <parent>
        <groupId>ru.qacourse</groupId>
        <artifactId>exercises-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <!-- Координаты этого модуля (groupId и version унаследованы от родителя) -->
    <artifactId>m06-build-tools</artifactId>
    <name>m06 — Сборка, Lombok, Jackson, конфиги</name>

    <dependencies>
        <!-- Lombok: генерирует геттеры, сеттеры, конструкторы при компиляции. provided — нужен только при сборке -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson: превращает объекты в JSON и обратно -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Owner: удобное чтение настроек через интерфейс -->
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
        </dependency>

        <!-- Библиотеки для тестов: scope test — в итоговую программу не попадают -->
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Явно подключаем Lombok как обработчик аннотаций (в новых JDK это обязательно) -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
