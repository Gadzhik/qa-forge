<?xml version="1.0" encoding="UTF-8"?>
<!--
  Модуль 11: базы данных — SQL, JDBC, HikariCP, проверки в БД.
  По умолчанию тесты подключаются к встроенной базе запущенного QA Burger: jdbc:h2:tcp://localhost:9093/mem:shop
  С Docker (docker compose up -d postgres + QA Burger с профилем docker):
    -Dshop.db.url=jdbc:postgresql://localhost:5432/qaburger
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.qacourse</groupId>
        <artifactId>exercises-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>m11-databases</artifactId>
    <name>m11 — Базы данных</name>

    <dependencies>
        <!-- пул соединений -->
        <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId></dependency>
        <!-- JDBC-драйверы: PostgreSQL и H2 (H2 приходит вместе с test-support) -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
        <dependency><groupId>ru.qacourse</groupId><artifactId>test-support</artifactId></dependency>
        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
